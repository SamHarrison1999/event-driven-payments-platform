# Synthetic local-development values only.
# Do not reuse these credentials in any deployed environment.

POSTGRES_DB=payments_platform
POSTGRES_USER=payments_app
POSTGRES_PASSWORD=payments_local_dev_only
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/payments_platform
DATABASE_USERNAME=payments_app
DATABASE_PASSWORD=payments_local_dev_only

APP_VERSION=0.0.1-SNAPSHOT

# Phase 12 security controls. Keep enabled outside local test execution.
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_WINDOW=1m
SECURITY_RATE_LIMIT_MAX_TRACKED_KEYS=10000
SECURITY_RATE_LIMIT_LOGIN_REQUESTS=10
SECURITY_RATE_LIMIT_REGISTRATION_REQUESTS=5
SECURITY_RATE_LIMIT_PAYMENT_REQUESTS=60
SECURITY_RATE_LIMIT_SETTLEMENT_IMPORT_REQUESTS=10
